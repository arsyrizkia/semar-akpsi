# Salin ke .env.local. Jangan commit nilai asli.
DATABASE_URL=            # Neon (pooled); dipakai aplikasi
DATABASE_URL_UNPOOLED=   # opsional; dipakai drizzle-kit push bila ada
AUTH_SECRET=             # rahasia penandatangan sesi dan token SSO; bila kosong dipakai cadangan turunan DATABASE_URL (hanya untuk prototipe)
BIMA_API_KEY=            # opsional; kunci bersama klien SEMAR dan API BIMA tiruan (bawaan: turunan AUTH_SECRET)
BIMA_BASE_URL=           # opsional; basis URL API BIMA tiruan (bawaan: VERCEL_URL atau http://localhost:3000)
BLOB_READ_WRITE_TOKEN=   # opsional; tanpa ini berkas disimpan di basis data (bytea)
ANTHROPIC_API_KEY=       # opsional; tanpa ini LLM memakai mode tiruan
SEMAR_LLM_MODE=          # "tiruan" memaksa mode tiruan
SEMAR_LLM_MODEL=         # bawaan claude-opus-5-5
